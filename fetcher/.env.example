# Kopiera till fetcher/.env och fyll i. Gratis nyckel: https://bykaranteli.com/dashboard/api
# Utan nyckel hoppas ETF-flödena över och lampan behåller senaste kända värde.
BYKARANTELI_API_KEY=

# Valfri gratis nyckel: https://fred.stlouisfed.org/docs/api/api_key.html
# Används för 10-årig ränta (DGS10) och som reserv för USDSEK. Utan nyckel: Yahoo ^TNX resp. Riksbanken.
FRED_API_KEY=

# Valfritt: GitHub-repo for "walter deploy" (GitHub Pages). Tomt = Netlify Drop.
# Exempel: WALTER_PAGES_REPO=https://github.com/DITTNAMN/walter.git
WALTER_PAGES_REPO=

# Ägarens åtkomstkod till det krypterade valvet (skapa med: python fetcher/walter_vault.py ny-kod)
WALTER_OWNER_KEY=
